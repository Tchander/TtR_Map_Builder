{
  "name": "ttr-map-builder",
  "version": "1.2.7",
  "description": "Редактор игровых полей с размерами в миллиметрах",
  "author": "TtR Map Builder",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "test": "vitest run",
    "start": "electron .",
    "build:exe": "npm run build && electron-builder --win portable --x64 && node scripts/copy-release.mjs",
    "test:e2e": "node scripts/smoke.mjs",
    "test:e2e:portable": "node scripts/smoke.mjs --portable",
    "test:routes": "node scripts/routes-smoke.mjs",
    "test:routes:portable": "node scripts/routes-smoke.mjs --portable"
  },
  "build": {
    "appId": "local.ttr.mapbuilder",
    "productName": "TtR Map Builder",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "TtR Map Builder.exe",
      "requestExecutionLevel": "user"
    }
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
